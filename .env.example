SECRET_KEY=change-this-in-production-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=*
# For local development with SQLite, leave DATABASE_URL unset or empty
# For PostgreSQL in production, set:
# DATABASE_URL=postgres://user:password@localhost:5432/focus_cup_db
CORS_ALLOW_ALL_ORIGINS=True
# Frontend API URL configuration (port 8002 in local multi-app dev environment)
NEXT_PUBLIC_API_URL=http://localhost:8002
